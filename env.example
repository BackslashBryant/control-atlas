# Preferred on Windows: set GITHUB_TOKEN in the user-level environment so new Cursor/Codex/Antigravity sessions inherit it.
# Use an ignored .env.local bridge only if a repo-local tool explicitly requires one.
GITHUB_TOKEN=
GITHUB_REPO=rambulls/GovFrame
NVD_API_KEY=

# Canonical ports used by guarded dev scripts.
HTTP_PORT=3000
API_PORT=
WS_PORT=
