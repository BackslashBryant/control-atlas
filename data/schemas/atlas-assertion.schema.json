{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-atlas.local/schemas/atlas-assertion.schema.json",
  "title": "Control Atlas evidence-bearing assertion",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "profile_id", "subject_id", "predicate", "object_id", "directionality", "assertion_class", "authority", "lifecycle", "evidence_refs"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "pattern": "^assertion\\." },
    "subject_id": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "object_id": { "type": "string", "minLength": 1 },
    "directionality": { "enum": ["directed", "symmetric"] },
    "assertion_class": { "enum": ["structural", "published_mapping", "publisher_derived", "atlas_navigation", "atlas_inferred"] },
    "authority": { "type": "string", "minLength": 1 },
    "lifecycle": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "transformation": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "assertion_class": { "const": "atlas_inferred" } } },
      "then": { "required": ["confidence", "transformation"] },
      "else": { "not": { "required": ["confidence"] } }
    },
    {
      "if": { "properties": { "assertion_class": { "enum": ["structural", "atlas_navigation"] } } },
      "then": {},
      "else": { "properties": { "evidence_refs": { "minItems": 1 } } }
    }
  ]
}
