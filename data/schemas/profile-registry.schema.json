{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-atlas.local/schemas/profile-registry.schema.json",
  "title": "Control Atlas entity profile registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "origin_classes", "lifecycle_statuses", "profiles"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "origin_classes": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } },
    "lifecycle_statuses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "entity_kind", "native_type", "status"],
        "properties": {
          "profile_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
          "entity_kind": { "enum": ["organization", "publication", "artifact", "content_record", "resource", "assertion"] },
          "native_type": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "dormant"] },
          "parent_profile_id": { "type": ["string", "null"] },
          "required_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "optional_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "allowed_origins": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "evidence_required_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "display_sections": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "allowed_assertion_classes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
