{
  "schema_version": "1.0",
  "templates": [
    {
      "template_id": "tpl-ssp-starter",
      "name": "security_plan_starter",
      "display_name": "Security Plan Starter",
      "description": "Baseline worksheet that lists your framework's controls with implementation, evidence, and inheritance prompts — a starting point for an SSP, not a finished plan.",
      "artifact_type": "security_plan_starter",
      "supported_formats": ["markdown", "csv"],
      "office_formats": ["docx"],
      "input_options": ["framework", "baseline", "control_family", "environment_archetype"],
      "source_refs": ["nist-oscal", "nist-800-37-rev2"],
      "official_alternative": {
        "label": "FedRAMP System Security Plan (SSP) template",
        "url": "https://www.fedramp.gov/documents-templates/"
      },
      "disclaimer_required": true
    },
    {
      "template_id": "tpl-impl-stmt",
      "name": "implementation_statement_worksheet",
      "display_name": "Implementation Statement Worksheet",
      "description": "Worksheet to draft control implementation statements control by control.",
      "artifact_type": "implementation_statement_worksheet",
      "supported_formats": ["csv", "json"],
      "office_formats": ["xlsx"],
      "input_options": ["framework", "selected_controls"],
      "source_refs": ["nist-oscal"],
      "official_alternative": {
        "label": "NIST OSCAL SSP implementation model",
        "url": "https://pages.nist.gov/OSCAL/learn/concepts/layer/implementation/ssp/"
      },
      "disclaimer_required": true
    },
    {
