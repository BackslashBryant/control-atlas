# Ignore everything by default. Re-allow only the public product surface.
*
!.gitignore
!README.md
!index.html
!package.json
!package-lock.json
!app/
!app/*.mjs
!app/content/
!app/content/*.mjs
!styles/
!styles/*.css
!tests/
!tests/*.mjs
!tests/fixtures/
!tests/fixtures/**
!docs/
!docs/**

!.github/
!.github/workflows/
!.github/workflows/ci.yml
!.github/workflows/nightly-refresh.yml
!.github/workflows/pages.yml

!lib/
lib/*
!lib/d3.min.js

!scripts/
scripts/*
!scripts/build-framework-data.mjs
!scripts/audit-coverage.mjs
!scripts/check-data-size.mjs
!scripts/fetch-ccis.mjs
!scripts/fetch-olir-mappings.mjs
!scripts/fetch-framework-catalogs.mjs
!scripts/refresh-data.mjs
!scripts/static-smoke.mjs
!scripts/dom-smoke.mjs
!scripts/lib/
scripts/lib/*
!scripts/lib/framework-engine.mjs
!scripts/lib/cci-adapter.mjs
!scripts/lib/oscal-normalize.mjs
!scripts/lib/resolve-source-tier.mjs
!scripts/lib/framework-adapters.mjs
!scripts/lib/source-registry.mjs
!scripts/lib/olir-adapter.mjs
!scripts/lib/800-171-mapping-adapter.mjs
!scripts/lib/catalog-adapters-ext.mjs
!scripts/lib/cci-diff-report.mjs

!data/
data/*
!data/*.json
data/tenable-sync-state.json
!data/generated/
!data/generated/*.json
!data/shards/
data/shards/*
!data/shards/*.json

!maps/
maps/*
!maps/*.json
