# Ignore everything by default. Re-allow only the public product surface.
*
!.gitignore
!README.md
!index.html
!package.json
!package-lock.json

!.github/
!.github/workflows/
!.github/workflows/ci.yml
!.github/workflows/nightly-refresh.yml
!.github/workflows/pages.yml

!lib/
lib/*
!lib/d3.min.js

!scripts/
scripts/*
!scripts/build-xref.mjs
!scripts/check-data-size.mjs
!scripts/fetch-ccis.mjs
!scripts/fetch-nvd.mjs
!scripts/fetch-oscal-catalogs.mjs
!scripts/refresh-data.mjs
!scripts/static-smoke.mjs
!scripts/lib/
scripts/lib/*
!scripts/lib/oscal-normalize.mjs
!scripts/lib/resolve-source-tier.mjs

!data/
data/*
!data/*.json
data/tenable-sync-state.json
!data/shards/
data/shards/*
!data/shards/*.json

!maps/
maps/*
!maps/*.json
