{
  "name": "control-atlas",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "The public map for federal cyber compliance.",
  "scripts": {
    "build:site": "node ./tools/build-static-site.mjs",
    "build:data": "node ./scripts/build-framework-data.mjs",
    "build:xref": "npm run build:data",
    "audit:deps": "node ./scripts/security/npm-audit.mjs",
    "lint": "eslint src tests/graph tests/browser-contract.test.mjs tests/build-layout-contract.test.mjs tests/framework-runtime.test.mjs tests/package-scripts.test.mjs tests/e2e/control-atlas-shell.spec.mjs tests/e2e/critical-path-matrix.spec.mjs tests/e2e/landing-performance.spec.mjs tests/e2e/accessibility.spec.mjs tests/e2e/frontend-responsive.spec.mjs tests/e2e/atlas-map-source-hierarchy.spec.mjs tests/e2e/atlas-map-focused-control.spec.mjs tests/e2e/atlas-map-source-filters.spec.mjs tests/e2e/atlas-map-links.spec.mjs tests/e2e/navigation-fidelity.spec.mjs scripts/dom-smoke.mjs scripts/static-smoke.mjs scripts/audit-coverage.mjs tools/build-static-site.mjs tools/check-licenses.mjs tools/serve-static-site.mjs tools/sync-public.mjs vite.config.ts --ext .mjs,.ts,.tsx --max-warnings=0",
    "ports:status": "node ./tools/ports-status.mjs",
    "fetch:frameworks": "node ./scripts/fetch-framework-catalogs.mjs",
    "fetch:ccis": "node ./scripts/fetch-ccis.mjs",
    "fetch:disa-stigs": "node ./scripts/fetch-disa-stigs.mjs",
    "fetch:mitre": "node ./scripts/fetch-mitre-data.mjs",
    "fetch:olir-mappings": "node ./scripts/fetch-olir-mappings.mjs",
    "extract:dod-zt": "node ./scripts/extract-dod-zt.mjs",
    "check:data-size": "node ./scripts/check-data-size.mjs",
    "license:check": "node ./tools/check-licenses.mjs",
    "smoke:static": "node ./scripts/static-smoke.mjs",
    "refresh:data": "node ./scripts/refresh-data.mjs",
    "sbom:generate": "cyclonedx-npm --package-lock-only --output-format json --output-file artifacts/sbom.cdx.json",
    "test": "npm run test:data && npm run test:runtime && npm run test:graph",
    "test:data": "node --test --test-concurrency=1 ./tests/source-registry.test.mjs ./tests/template-registry.test.mjs ./tests/template-export-contract.test.mjs ./tests/template-office-export.test.mjs ./tests/federal-graph-contract.test.mjs ./tests/framework-data.test.mjs ./tests/dod-zt-extract.test.mjs ./tests/oscal-normalize.test.mjs ./tests/disa-stig-importer.test.mjs ./tests/mitre-attack-importer.test.mjs ./tests/mitre-d3fend-importer.test.mjs ./tests/stig-source-observer.test.mjs ./tests/retired-concepts.test.mjs ./tests/alignment-contract.test.mjs ./tests/package-scripts.test.mjs ./tests/prd-alignment.test.mjs ./tests/start-here-recommendations.test.mjs ./tests/glossary-search.test.mjs ./tests/a11y-contract.test.mjs ./tests/content-review.test.mjs",
    "test:e2e": "npm run build:site && playwright test",
    "test:a11y": "npm run build:site && playwright test tests/e2e/accessibility.spec.mjs",
    "test:runtime": "node --test ./tests/framework-runtime.test.mjs ./tests/graph-layout.test.mjs ./tests/graph-clustering.test.mjs",
    "test:graph": "tsx --test ./tests/graph/sourceManifest.test.ts ./tests/graph/sourceLinks.test.ts ./tests/graph/defaultMapFilter.test.ts ./tests/graph/sourceToGraphRole.test.ts ./tests/graph/sourceHierarchyEdges.test.ts ./tests/graph/buildFocusedControlRings.test.ts",
    "test:browser": "node --test ./tests/browser-contract.test.mjs",
    "smoke:dom": "node ./scripts/dom-smoke.mjs",
    "audit:coverage": "node ./scripts/audit-coverage.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.app.json --noEmit",
    "verify:public": "npm run check:data-size && npm run smoke:static && npm run audit:coverage",
    "git:push": "node ./tools/git-push-with-retry.mjs",
    "checks:wait": "node ./tools/wait-for-checks.mjs",
    "ship:main": "node ./tools/ship-to-main.mjs",
    "precommit": "npm run build:site && npm run lint && npm run typecheck && npm run license:check && npm test && npm run test:browser && npm run smoke:dom && npm run verify:public && npm run test:a11y && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cyclonedx/cyclonedx-npm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.11.0",
    "eslint": "^10.5.0",
    "fast-xml-parser": "^5.2.5",
    "globals": "^17.7.0",
    "pdf-parse": "^1.1.1",
    "read-excel-file": "^9.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@tabler/icons-react": "^3.44.0",
    "@xyflow/react": "^12.11.1",
    "elkjs": "^0.11.1",
    "fflate": "^0.8.3",
    "minisearch": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0"
  }
}
