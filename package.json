{
  "name": "control-atlas",
  "version": "1.0.0",
  "private": true,
  "description": "The public map for federal cyber compliance.",
  "scripts": {
    "build:site": "node ./tools/build-static-site.mjs",
    "build:data": "node ./scripts/build-framework-data.mjs",
    "build:xref": "npm run build:data",
    "audit:deps": "node ./scripts/security/npm-audit.mjs",
    "lint": "eslint src tests/browser-contract.test.mjs tests/build-layout-contract.test.mjs tests/framework-runtime.test.mjs tests/package-scripts.test.mjs tests/e2e/control-atlas-shell.spec.mjs scripts/dom-smoke.mjs scripts/static-smoke.mjs scripts/audit-coverage.mjs tools/build-static-site.mjs tools/check-licenses.mjs tools/serve-static-site.mjs tools/sync-public.mjs --max-warnings=0",
    "fetch:frameworks": "node ./scripts/fetch-framework-catalogs.mjs",
    "fetch:ccis": "node ./scripts/fetch-ccis.mjs",
    "fetch:disa-stigs": "node ./scripts/fetch-disa-stigs.mjs",
    "fetch:olir-mappings": "node ./scripts/fetch-olir-mappings.mjs",
    "check:data-size": "node ./scripts/check-data-size.mjs",
    "license:check": "node ./tools/check-licenses.mjs",
    "smoke:static": "node ./scripts/static-smoke.mjs",
    "refresh:data": "node ./scripts/refresh-data.mjs",
    "sbom:generate": "cyclonedx-npm --package-lock-only --output-format json --output-file artifacts/sbom.cdx.json",
    "test": "npm run test:data && npm run test:runtime",
    "test:data": "node --test --test-concurrency=1 ./tests/source-registry.test.mjs ./tests/federal-graph-contract.test.mjs ./tests/framework-data.test.mjs ./tests/oscal-normalize.test.mjs ./tests/disa-stig-importer.test.mjs ./tests/stig-source-observer.test.mjs ./tests/retired-concepts.test.mjs ./tests/alignment-contract.test.mjs ./tests/package-scripts.test.mjs",
    "test:e2e": "npm run build:site && playwright test",
    "test:runtime": "node --test ./tests/framework-runtime.test.mjs",
    "test:browser": "node --test ./tests/browser-contract.test.mjs",
    "smoke:dom": "node ./scripts/dom-smoke.mjs",
    "audit:coverage": "node ./scripts/audit-coverage.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify:public": "npm run check:data-size && npm run smoke:static && npm run audit:coverage",
    "precommit": "npm run build:site && npm run lint && npm run typecheck && npm run license:check && npm test && npm run test:browser && npm run smoke:dom && npm run verify:public && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.3",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  }
}
