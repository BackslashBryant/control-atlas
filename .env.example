# GovFrame Navigator local environment
# Copy to .env.local only when a task needs local source-refresh credentials.

# Application metadata
APP_NAME=GovFrame Navigator
APP_VERSION=0.0.0
APP_URL=http://localhost:3000
NODE_ENV=development

# Optional source API key for full NVD seed or higher-rate refresh tests.
# Do not expose this to browser runtime code.
NVD_API_KEY=

# Optional GitHub token for local repo automation only.
GITHUB_TOKEN=
GITHUB_REPO=BackslashBryant/GovFrame

# Canonical ports used by guarded local preview scripts.
HTTP_PORT=3000
